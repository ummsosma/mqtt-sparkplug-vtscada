# Copy to .env and edit. `.env` is gitignored; docker compose reads it
# automatically for the ${VAR:-default} substitutions in docker-compose.yml.
#
# Nothing here is required -- every setting has a working default for a
# local, all-in-Docker run. The ones you must change to talk to a REAL system
# are marked REQUIRED below.

# ---------------------------------------------------------------- broker
MQTT_HOST=emqx
MQTT_PORT=1883
# Leave blank for an anonymous broker.
MQTT_USERNAME=
MQTT_PASSWORD=
# Dashboard password for http://<host>:18083 (user: admin).
EMQX_DASHBOARD_PASSWORD=public1234
# How long the broker keeps this client's session -- and therefore any messages
# the collector has not acknowledged yet -- while the collector is disconnected.
#
# This is sent in the MQTT v5 CONNECT packet, and for a v5 client that is the
# value that applies: the broker's own session_expiry_interval setting is for
# 3.1/3.1.1 clients, which cannot ask for one. Getting this too low is silent data
# loss -- the broker has already acknowledged the PLC, so the PLC will not resend,
# and the queued messages are discarded when the session expires.
MQTT_SESSION_EXPIRY_SEC=604800

# ------------------------------------------------------------- database
DB_HOST=timescaledb
DB_PORT=5432
DB_USER=emqx
# REQUIRED (change it): this is also the password the timescaledb container is
# created with, so changing it after the first `up` means recreating the volume.
DB_PASSWORD=emqx
DB_NAME=emqx
# The queue lives in this schema inside the database above. The collector creates
# its tables on startup, so there is nothing to initialise by hand.
DB_SCHEMA=pipeline
# Days of DELIVERED history and audit rows to keep. Pending rows are never
# pruned -- they are the work still owed to the historian. 0 = keep forever.
# Applied by the bridge at startup and once a day.
RETENTION_DAYS=90

# ----------------------------------------------------- PLC input decoding
# What the collector subscribes to.
PLC_TOPIC=plc/#
# auto | json | topic_tag | sparkplug -- see src/pipeline/decoder.py
PLC_DECODER=auto
# Used when the payload carries no device id.
PLC_DEVICE_ID=plc1
# topic_tag decoder: trailing topic levels read as <device>/<tag>. 2 means
# `plc/<device>/<tag>`; 1 means only the tag is in the topic and the device comes
# from PLC_DEVICE_ID.
PLC_TOPIC_TAG_LEVELS=2
# Map a whole topic to a tag name when the topic carries no usable name, e.g.
#   PLC_TAG_MAP={"plc/1": "DS1"}
# The resulting name must also appear in VTS_TAGS.
PLC_TAG_MAP=
# Field paths for PLC_DECODER=json. Dotted paths reach nested values:
# PLC_JSON_VALUE_FIELD=payload.value
PLC_JSON_TAG_FIELD=tag
PLC_JSON_VALUE_FIELD=value
PLC_JSON_TS_FIELD=ts
PLC_JSON_SEQ_FIELD=seq
PLC_JSON_DEVICE_FIELD=device
# NEW payload shape without editing code: point at a JSON mapping file
# (a copy of plc-mapping/example.json) describing tag/field paths, renames and
# value transforms. Requires PLC_DECODER=mapping.
#   PLC_DECODER=mapping
#   PLC_MAPPING_FILE=/plc-mapping/plc.json
PLC_MAPPING_FILE=

# -------------------------------------------------------- Sparkplug B out
# Group and edge node id. These decide BOTH the MQTT topic
# (spBv1.0/<GROUP>/NDATA/<EDGE>) and the VTScada tag path, so they must match
# the tag addresses the VTScada MQTT driver has created.
VTS_GROUP=SFTest
VTS_EDGE=sf-pi
# tag -> datatype. Only tags listed here are published.
VTS_TAGS={"AI01": "double", "DI01": "bool"}

# ------------------------------------------------- VTScada REST (the oracle)
# Where VTScada's REST interface answers. It has to be reachable from wherever the
# bridge runs. The three answers that cover almost every case:
#   http://host.docker.internal:443   VTScada is on the same machine as Docker
#                                     (the default; matches docker-compose.yml)
#   http://localhost:443              the bridge runs directly on the VTScada box
#   http://<LAN-or-VPN-address>:443   VTScada on another machine, on the same LAN
#                                     (no VPN needed) — e.g. http://192.168.1.50:443
VTS_REST_URL=http://host.docker.internal:443
VTS_REST_REALM=odbc
VTS_REST_USER=admin
# REQUIRED: the VTScada account password. The account needs Remote Data Access
# plus Remote Tag Value/History Retrieve.
VTS_REST_PASSWORD=
# How delivery is proved. Default 'readback' requires the REST interface above.
# If the bridge CANNOT reach VTScada REST at all, set:
#     BRIDGE_CONFIRM_MODE=publish
# which marks rows delivered as soon as the MQTT publish succeeds (fire-and-forget).
# Weaker: nothing proves VTScada really stored the data, and there is no
# backlog/STANDBY protection. Only use it when REST is genuinely unavailable.
# Prefix of the History table's column names:
# <VTS_TAG_ROOT>\<GROUP>\<EDGE>\<TAG>:Value
VTS_TAG_ROOT=MQTT Context\MQTT-SB\MQTT-DRIVER

# ------------------------------------------------------------ tuning
BRIDGE_BATCH=50
# readback (default, needs VTScada REST) | publish (no REST, fire-and-forget)
BRIDGE_CONFIRM_MODE=readback
# Publish a 4242 probe sample after the BIRTH and wait for it to appear in the
# historian. Off by default because the probe writes a real sample into the tag's
# history on every bridge start. Not needed for correctness: a batch published
# inside the post-BIRTH window simply fails to confirm and is retried.
BRIDGE_WARMUP_PROBE=false
LOG_LEVEL=INFO
